{
  "name": "@floracodex/eslint-config",
  "version": "1.1.2",
  "description": "Shared ESLint flat-config presets for Flora Codex TypeScript projects (lib, backend, frontend, functions)",
  "type": "module",
  "exports": {
    "./lib": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      }
    },
    "./backend": {
      "import": {
        "types": "./dist/backend.d.ts",
        "default": "./dist/backend.js"
      }
    },
    "./frontend": {
      "import": {
        "types": "./dist/frontend.d.ts",
        "default": "./dist/frontend.js"
      }
    },
    "./functions": {
      "import": {
        "types": "./dist/functions.d.ts",
        "default": "./dist/functions.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "prelint": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "prelint:fix": "npm run build",
    "lint:fix": "eslint . --fix",
    "preformat": "npm run build",
    "format": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "typescript",
    "floracodex"
  ],
  "author": "Flora Codex, LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floracodex/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/floracodex/eslint-config/issues"
  },
  "homepage": "https://github.com/floracodex/eslint-config#readme",
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "angular-eslint": "^21.3.1",
    "globals": "^17.5.0",
    "typescript-eslint": "^8.59.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
